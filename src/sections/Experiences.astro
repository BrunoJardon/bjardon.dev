---
import { Image } from "astro:assets";
---

<section id="experiences">
  <h2>Experiencias</h2>
  <ul class="experience-list">
    <li>
      <article class="experience-card">
        <header>
          <Image
            src="/src/assets/imgs/logos/JoseHernandez.webp"
            alt="Logo de José Hernández"
            width={100}
            height={100}
          />
          <h3>José Hernández</h3>
          <p class="job-position">Desarrollador Full Stack</p>
          <p class="job-duration">Noviembre 2023 - Febrero 2023</p>
        </header>
        <div class="job-description">
          <p>
            Participé en el desarrollo colaborativo de un sistema de consultas,
            creando el frontend con HTML, CSS (Bootstrap) y JavaScript (Axios).
          </p>
          <p>
            En el backend, trabajé con Java Spring Boot y MySQL para garantizar
            la funcionalidad del sistema.
          </p>
        </div>
      </article>
    </li>
    <li>
      <article class="experience-card">
        <header>
          <Image
            src="/src/assets/imgs/logos/VivenciasBaires.webp"
            alt="Logo de Vivencias Baires"
            width={100}
            height={100}
          />
          <h3>Vivencias Baires</h3>
          <p class="job-position">Desarrollador Full Stack</p>
          <p class="job-duration">Noviembre 2023 - Actualidad</p>
        </header>
        <div class="job-description">
          <p>
            Especializado en la creación de interfaces de usuario reactivas y
            adaptables usando TypeScript, NextJS, React y TailwindCSS.
          </p>
          <p>
            Desarrollo de APIs RESTful con Java Spring Boot y NestJS,
            implementación de seguridad con JWT y trabajo con bases de datos
            MongoDB.
          </p>
        </div>
      </article>
    </li>
  </ul>
</section>
