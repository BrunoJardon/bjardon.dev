---
import { Image } from "astro:assets";

import { ExpandBtn } from "@/components/ExpandBtn";

const experiences = [
  {
    company: "Jose Hernández",
    position: "Desarrollador Full Stack",
    duration: "Noviembre 2023 - Febrero 2023",
    description: [
      "Participé en el desarrollo colaborativo de un sistema de consultas, creando el frontend con HTML, CSS (Bootstrap) y JavaScript (Axios).",
      "En el backend, trabajé con Java Spring Boot y MySQL para garantizar la funcionalidad del sistema.",
    ],
    image: "JoseHernandez.webp",
  },
  {
    company: "Vivencias Baires",
    position: "Desarrollador Full Stack",
    duration: "Noviembre 2023 - Mayo 2024",
    description: [
      "Especializado en la creación de interfaces de usuario reactivas y adaptables usando TypeScript, NextJS, React y TailwindCSS.",
      "Desarrollo de APIs RESTful con Java Spring Boot y NestJS, implementación de seguridad con JWT y trabajo con bases de datos MongoDB.",
    ],
    image: "VivenciasBaires.webp",
  },
];
---

<section id="experiences">
  <h2>Experiencias</h2>
  <ul class="flex flex-wrap justify-center items-start">
    {
      experiences.map((experience) => (
        <li class="max-w-sm m-4 sm:mt-12">
          <article class="experiences-card">
            <header class="flex flex-col items-center sm:relative">
              <Image
                class="rounded-full sm:absolute sm:-top-12"
                src={`/assets/imgs/logos/${experience.image}`}
                alt={`Logo de ${experience.company}`}
                width={100}
                height={100}
              />
              <div class="h-0 sm:h-14" />
              <h3 class="text-xl">{experience.company}</h3>
              <p class="font-light">{experience.position}</p>
              <p class="font-light">{experience.duration}</p>
            </header>
            <ExpandBtn
              styles="text-font-a px-6 py-4 rounded-md"
              dynamicBg={true}
              client:load
            >
              {experience.description.map((description) => (
                <p class="paragraph">{description}</p>
              ))}
            </ExpandBtn>
          </article>
        </li>
      ))
    }
  </ul>
</section>
