---
import { Image } from "astro:assets";

const skills = [
  {
    Frontend: [
      {
        name: "HTML",
        image: "html.svg",
      },
      {
        name: "CSS",
        image: "css.svg",
      },
      {
        name: "JavaScript",
        image: "js.svg",
      },
      {
        name: "React",
        image: "react.svg",
      },
      {
        name: "NextJS",
        image: "nextjs.svg",
      },
      {
        name: "TailwindCSS",
        image: "tailwind.svg",
      },
    ],
    Backend: [
      {
        name: "NodeJS",
        image: "nodejs.svg",
      },
      {
        name: "NestJS",
        image: "nestjs.svg",
      },
      {
        name: "TypeScript",
        image: "ts.svg",
      },
      {
        name: "PHP",
        image: "php.svg",
      },
      {
        name: "Spring",
        image: "spring-boot.svg",
      },
    ],
    Databases: [
      {
        name: "MongoDB",
        image: "mongodb.svg",
      },
      {
        name: "MySQL",
        image: "mysql.svg",
      },
    ],
    Herramientas: [
      {
        name: "Git",
        image: "git.svg",
      },
      {
        name: "VS Code",
        image: "vscode.svg",
      },
      {
        name: "Bash",
        image: "bash.svg",
      },
      {
        name: "VirtualBox",
        image: "virtualbox.webp",
      },
      {
        name: "Docker",
        image: "docker.svg",
      },
    ],
    "Sistemas Operativos": [
      {
        name: "Ubuntu",
        image: "ubuntu.svg",
      },
      {
        name: "Debian",
        image: "debian.svg",
      },
      {
        name: "Windows",
        image: "windows.svg",
      },
    ],
  },
];
---

<section id="skills">
  <h2>Habilidades</h2>
  <div
    class="bg-background-a p-3 my-4 w-full grid grid-cols-2 gap-3 rounded-md [&>*:last-child]:col-span-2 [&>*:last-child>ul]:justify-evenly"
  >
    {
      Object.keys(skills[0]).map((category) => (
        <section class="skill-card">
          <h3>{category}</h3>
          <ul class="skill-list">
            {skills[0][category].map((skill) => (
              <li class="skill-item">
                <Image
                  class="skill-icon"
                  src={`/assets/imgs/skills/${skill.image}`}
                  alt={skill.name}
                  title={skill.name}
                  width={50}
                  height={50}
                  loading="lazy"
                />
                <p class="skill-name">{skill.name}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>
