---
import { Image } from "astro:assets";

const educations = [
  {
    name: "José Hernández",
    degree: "Técnicatura en Informática",
    duration: "Marzo 2016 - Diciembre 2023",
    image: "JoseHernandez.webp",
  },
  {
    name: "UNLP",
    degree: "Ingeniería en Computación",
    duration: "Enero 2025 - Actualidad",
    image: "UNLP.webp",
  },
  {
    name: "@virginia_speaking",
    degree: "Inglés Técnico",
    duration: "Marzo 2024 - Actualidad",
  },
];
---

<section id="studies">
  <h2>Estudios</h2>
  <ul class="flex flex-col justify-center sm:items-center sm:justify-around sm:flex-wrap sm:flex-row">
    {
      educations.map((education) => (
        <li>
          <article class="education-card">
            {education.image != null && (
              <Image
                class="rounded-full sm:absolute sm:-top-10"
                src={`/assets/imgs/logos/${education.image}`}
                alt={education.name}
                width={84}
                height={84}
                loading="lazy"
              />
              <div class="w-0 sm:h-[42px]"></div>
            )}
            <div class="w-full font-light">
              <h3 class="font-bold">{education.name}</h3>
              <p class="m-0">{education.degree}</p>
              <p class="m-0">{education.duration}</p>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>
