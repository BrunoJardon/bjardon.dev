---
import { Image } from "astro:assets";
import { title } from "@/constants.js";
---

<section id="hero">
  <Image
    src="/src/assets/imgs/perfil.webp"
    alt="Foto de perfil de Jardón Bruno"
    width={350}
    height={350}
    loading="eager"
  />
  <a href="/src/assets/files/CV-Jardon-Bruno.pdf" class="cta-button">Ver CV</a>
  <h1>Jardón Bruno Noel</h1>
  <p class="job-title">{title}</p>
  <p class="bio">
    +1 año de experiencia en el desarrollo de software,
    <strong>técnico en informática.</strong>
  </p>
</section>
